# Shared image for the Python services: backend (API + ML + agent), simulator, OPC UA bridge.
FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md ./
COPY simulation ./simulation
COPY industrial ./industrial
COPY intelligence ./intelligence
COPY agents ./agents
COPY experiments ./experiments
RUN pip install --upgrade pip && pip install -e ".[llm]"
COPY config ./config
COPY apps/backend ./apps/backend
COPY database ./database
COPY alembic.ini ./
COPY models ./models
COPY experiments/results ./experiments/results
RUN useradd --create-home --uid 10001 oil && mkdir -p /app/data && chown -R oil /app/data
USER oil
EXPOSE 8000 4840
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s CMD curl -fsS http://localhost:8000/api/v1/health || exit 1
CMD ["python", "-m", "uvicorn", "app.main:app", "--app-dir", "apps/backend", "--host", "0.0.0.0", "--port", "8000"]
