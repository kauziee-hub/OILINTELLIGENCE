# =============================================================================
# OILINTELLIGENCE - environment configuration
#   cp .env.example .env      then set every value marked REQUIRED.
# Local development (no Docker) needs none of the REQUIRED values: SQLite and
# the in-process bus are used and seed passwords are generated on first start
# (written to data/initial_credentials.txt).
# =============================================================================

# ---- Application -------------------------------------------------------------
APP_ENV=development                 # development | pilot | production
DATA_MODE=SIMULATION                # SIMULATION | PLANT  (FR-018: never mixed in one deployment)

# ---- Databases ---------------------------------------------------------------
# Local default (leave unset): sqlite files in ./data
# DATABASE_URL=postgresql+psycopg://oilintel:<password>@localhost:5432/oilintel
# Simulator ground truth is a separate database; diagnostic code never reads it.
# TRUTH_DATABASE_URL=postgresql+psycopg://oilintel:<password>@localhost:5432/oilintel_truth
POSTGRES_PASSWORD=                  # REQUIRED for docker compose

# ---- Telemetry bus -----------------------------------------------------------
BUS=inproc                          # inproc (single process) | mqtt
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
# MQTT_USERNAME= / MQTT_PASSWORD=   per-service credentials (compose sets these)
EMBEDDED_BROKER=false               # true = start an amqtt broker inside the backend (dev only)
MQTT_SIMULATOR_PASSWORD=            # REQUIRED for docker compose
MQTT_BACKEND_PASSWORD=              # REQUIRED for docker compose
MQTT_OPCUA_PASSWORD=                # REQUIRED for docker compose
MQTT_GATEWAY_PASSWORD=              # optional: enables the plant-gateway publisher account

# ---- Simulator ---------------------------------------------------------------
SIMULATOR=local                     # local (inside backend) | remote (simulator container over MQTT)
SIM_SPEED=10                        # simulated seconds per wall-clock second
SIM_AUTOSTART=true
# PLANT_CONFIG=config/plant.yaml    # alternative plant definition

# ---- OPC UA ------------------------------------------------------------------
OPCUA_ENABLED=false                 # expose the simulated OPC UA server from the backend
OPCUA_ENDPOINT=opc.tcp://0.0.0.0:4840/oilintelligence/
# OPCUA_CERT=/certs/server_cert.der # enables Basic256Sha256 Sign&Encrypt
# OPCUA_KEY=/certs/server_key.pem

# ---- Security ----------------------------------------------------------------
AUTH_REQUIRED=true                  # false: no sign-in page (internal company network); see OPEN_ACCESS_*
OPEN_ACCESS_USER=control-room       # identity recorded in the audit log when AUTH_REQUIRED=false
OPEN_ACCESS_ROLE=admin
JWT_SECRET=                         # REQUIRED outside development: long random string
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=600
# Seed account passwords. Leave empty to generate random ones on first start.
SEED_ADMIN_PASSWORD=
SEED_ENGINEER_PASSWORD=
SEED_OPERATOR_PASSWORD=
SEED_VIEWER_PASSWORD=

# ---- Monitoring / diagnosis --------------------------------------------------
MONITOR_INTERVAL_S=300              # plant/sim seconds between balance evaluations
MONITOR_WINDOW_S=1800               # balance window length
ALARM_CONFIRMATIONS=2               # successive abnormal evaluations before an anomaly event (on-delay)
AUTO_INVESTIGATE=true               # open an investigation automatically on a confirmed anomaly
TELEMETRY_BUFFER_HOURS=14

# ---- Report narrative LLM (optional) -----------------------------------------
# none = deterministic template narrator (default, no external calls).
# anthropic = Claude writes the narrative; every number is checked against the
# evidence register and the template is used if the check fails.
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
ANTHROPIC_API_KEY=

# ---- Frontend / ops ----------------------------------------------------------
PUBLIC_API_URL=http://localhost:8000   # baked into the frontend image at build time
GRAFANA_ADMIN_PASSWORD=                # docker compose --profile monitoring
